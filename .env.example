# Database Configuration (Neon - PostgreSQL)
# Update with your actual Neon database credentials
DATABASE_URL=postgresql://username:password@endpoint.eu-west-2.aws.neon.tech/dbname?sslmode=require

# Supabase Configuration (Legacy - kept for reference)
# Only needed if maintaining Supabase integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Stripe Configuration (Payment Processing)
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
STRIPE_PRICE_ID=price_your_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Frontend Configuration
# URL where frontend is served (for CORS and redirects)
FRONTEND_URL=http://localhost:5000

# Server Configuration
# NODE_ENV: 'development' (API only on port 3001) or 'production' (static files on 5000)
NODE_ENV=development
API_PORT=3001

# CDN Configuration (Bunny.NET)
# Uncomment when CDN integration is configured
# BUNNY_CDN_HOSTNAME=your-cdn-hostname.bunnycdn.com
# BUNNY_ACCESS_KEY=your_bunny_access_key
